[Unit]
Description=llama.cpp server (dynamic models-dir, per-model presets)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/llama.cpp
CPUAffinity=0 1 6 7 8 9 10 11
Environment=MESA_SHADER_CACHE_DIR=%h/.cache/mesa_shader_cache
Environment=MESA_GLSL_CACHE_DIR=%h/.cache/mesa_glsl_cache
ExecStart=%h/llama.cpp/build-vulkan/bin/llama-server \
  --models-dir %h/models \
  --models-preset %h/.config/llama/models.ini \
  --models-max 3 \
  --parallel 4 \
  --host 0.0.0.0 \
  --port 8765
Restart=on-failure
RestartSec=2
Nice=-5

[Install]
WantedBy=default.target
